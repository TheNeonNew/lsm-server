{
  "info": {
    "_postman_id": "lsm-backend-collection",
    "name": "LSM Backend API Tests",
    "description": "Complete test collection for LSM Backend API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health & Info",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:8080/api/health",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8080",
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "API Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:8080/api",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8080",
              "path": ["api"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('userId', pm.response.json().user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"name\\\": \\\"Тест\\\",\\n  \\\"surname\\\": \\\"Пользователь\\\",\\n  \\\"patronymic\\\": \\\"Тестович\\\",\\n  \\\"email\\\": \\\"{{$randomEmail}}\\\",\\n  \\\"password\\\": \\\"TestPassword123\\\",\\n  \\\"position\\\": \\\"Инженер\\\"\\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8080/api/auth/register",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8080",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"email\\\": \\\"testuser@example.com\\\",\\n  \\\"password\\\": \\\"Password123\\\"\\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8080/api/auth/login",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
